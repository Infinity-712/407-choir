# Set these in the environment before npm start. This file is documentation only.
PORT=3001
# ICE_SERVERS=[{"urls":"stun:stun.example.com:3478"},{"urls":"turns:turn.example.com:5349","username":"short-lived-client-name","credential":"short-lived-client-credential"}]
# TURN_SHARED_SECRET=server-only-random-secret
# TURN_URLS=["turn:124.221.108.122:3478?transport=udp","turn:124.221.108.122:3478?transport=tcp","turns:124.221.108.122:5349?transport=tcp"]
# With TURN_SHARED_SECRET the server issues six-hour client credentials; never include this secret in ICE_SERVERS.
